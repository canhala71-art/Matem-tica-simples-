import assert from 'node:assert/strict';
import * as t from '../app/src/lib/tools.ts';
assert.equal(t.gcd(48, 36), 12); assert.equal(t.lcm(12, 18), 36); assert.equal(t.lcm(4, 6), 12);
assert.deepEqual(t.factorize(360), [[2, 3], [3, 2], [5, 1]]); assert.deepEqual(t.factorize(97), [[97, 1]]);
assert.deepEqual(t.euclidSteps(48, 36), ['48 = 1 × 36 + 12', '36 = 3 × 12 + 0']);
assert.deepEqual(t.fracOp({ n: 1, d: 2 }, { n: 1, d: 3 }, '+'), { n: 5, d: 6 });
assert.deepEqual(t.fracOp({ n: 3, d: 4 }, { n: 1, d: 4 }, '-'), { n: 1, d: 2 });
assert.deepEqual(t.fracOp({ n: 2, d: 3 }, { n: 3, d: 4 }, '*'), { n: 1, d: 2 });
assert.deepEqual(t.fracOp({ n: 1, d: 2 }, { n: 1, d: 4 }, '/'), { n: 2, d: 1 });
assert.deepEqual(t.fracOp({ n: 1, d: 3 }, { n: 1, d: -6 }, '+'), { n: 1, d: 6 });
assert.equal(t.mixed({ n: 7, d: 3 }), '2 1/3'); assert.equal(t.mixed({ n: 6, d: 3 }), '2'); assert.equal(t.mixed({ n: 1, d: 2 }), '1/2');
assert.deepEqual(t.decimalToFraction('0,75'), { n: 3, d: 4 }); assert.deepEqual(t.decimalToFraction('0.1'), { n: 1, d: 10 });
assert.deepEqual(t.decimalToFraction('-2,5'), { n: -5, d: 2 }); assert.deepEqual(t.decimalToFraction('3'), { n: 3, d: 1 });
assert.equal(t.fractionToDecimal({ n: 1, d: 4 }).text, '0,25'); assert.equal(t.fractionToDecimal({ n: 1, d: 3 }).text, '0,(3)');
assert.equal(t.fractionToDecimal({ n: 1, d: 6 }).text, '0,1(6)'); assert.equal(t.fractionToDecimal({ n: 22, d: 7 }).text, '3,(142857)');
assert.equal(t.fractionToDecimal({ n: -3, d: 2 }).text, '-1,5'); assert.equal(t.fractionToDecimal({ n: 4, d: 2 }).text, '2');
assert.equal(t.power(2, 10).text, '1024'); assert.equal(t.power(-3, 3).text, '-27'); assert.equal(t.power(2, -3).text, '1/8');
assert.equal(t.power(5, 0).text, '1'); assert.equal(t.power(2, 100).text, '1267650600228229401496703205376');
assert.equal(t.root(144, 2).exact, 12); assert.equal(t.root(-27, 3).exact, -3); assert.equal(t.root(50, 2).simplified, '5√2');
assert.equal(t.root(72, 2).simplified, '6√2'); assert.equal(t.root(2, 2).simplified, '√2'); assert.equal(t.root(54, 3).simplified, '3∛2');
assert.equal(t.root(0, 2).exact, 0); assert.throws(() => t.root(-4, 2));
assert.equal(t.percentOf(15, 200), 30); assert.equal(t.whatPercent(30, 120), 25); assert.equal(t.changeBy(200, 10, true), 220); assert.equal(t.changeBy(200, 25, false), 150);
assert.deepEqual(t.divide(29, 4), { q: 7, r: 1 }); assert.throws(() => t.divide(1, 0));
console.log('tools OK');
const fr = (r: t.PowerResult) => (r.exact ? `${r.exact.n}/${r.exact.d}` : 'approx');
assert.equal(fr(t.powerRational('0,5', '3')), '1/8'); assert.equal(fr(t.powerRational('2/3', '2')), '4/9');
assert.equal(fr(t.powerRational('-2/3', '3')), '-8/27'); assert.equal(fr(t.powerRational('0,1', '-2')), '100/1');
assert.equal(fr(t.powerRational('4', '0,5')), '2/1'); assert.equal(fr(t.powerRational('8', '2/3')), '4/1');
assert.equal(fr(t.powerRational('27/8', '-1/3')), '2/3'); assert.equal(fr(t.powerRational('-8', '1/3')), '-2/1');
assert.equal(fr(t.powerRational('5', '0')), '1/1'); assert.equal(fr(t.powerRational('1,5', '2')), '9/4');
const ap = t.powerRational('2', '0,5'); assert.equal(ap.exact, null); assert.ok(Math.abs(ap.approx! - Math.SQRT2) < 1e-12);
assert.throws(() => t.powerRational('-4', '0,5')); assert.throws(() => t.powerRational('0', '-1')); assert.throws(() => t.powerRational('2/0', '2'));
assert.equal(t.bigFractionToDecimal({ n: 9n, d: 4n }), '2,25'); assert.equal(t.bigFractionToDecimal({ n: 1n, d: 3n }), '0,(3)');
assert.equal(t.bigFractionToDecimal({ n: -1n, d: 8n }), '-0,125');
console.log('potências racionais OK');
